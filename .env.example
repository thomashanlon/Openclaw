# Compose deployment, image, and gateway
COMPOSE_PROJECT_NAME=my-openclaw
# Portainer reserves COMPOSE_PROJECT_NAME for the stack name, so host paths
# and Tailscale DNS use this separate, portable instance identifier.
OPENCLAW_INSTANCE_NAME=koolclaw
OPENCLAW_ENV_FILE=.env
# Versioned custom build; do not replace this with a floating tag.
OPENCLAW_IMAGE=ghcr.io/thomashanlon/openclaw:2026.8.2
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-value
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_TZ=Australia/Sydney
# Tailnet-only WebSocket URL advertised in mobile setup codes.
OPENCLAW_PUBLIC_URL=wss://whatever.example-tailnet.ts.net/

# Persistent host directories
OPENCLAW_CONFIG_DIR=./.openclaw-data/${COMPOSE_PROJECT_NAME}/config
OPENCLAW_WORKSPACE_DIR=./.openclaw-data/${COMPOSE_PROJECT_NAME}/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./.openclaw-data/${COMPOSE_PROJECT_NAME}/auth-profile-secrets

# GitHub CLI and HTTPS Git authentication.
# Use a fine-grained PAT with access only to the repositories agents need.
GH_TOKEN=github_pat_replace_me

# The same Headquarters MCP endpoint is registered three times. Each agent receives
# only its own environment-backed bearer identity.
HEADQUARTERS_MCP_URL=https://headquarters.example.com/mcp
HEADQUARTERS_T5H5_TOKEN=replace_me
HEADQUARTERS_FRINK_TOKEN=replace_me
HEADQUARTERS_HIGHWRIGHT_TOKEN=replace_me

# One BotFather token per agent. Use your numeric Telegram user ID (not your
# @username) so all three bots reject every other DM sender.
TELEGRAM_T5H5_BOT_TOKEN=replace_me
TELEGRAM_FRINK_BOT_TOKEN=replace_me
TELEGRAM_HIGHWRIGHT_BOT_TOKEN=replace_me
TELEGRAM_OWNER_USER_ID=123456789

# Optional OpenAI Platform key for TTS and required for GPT-Live Realtime Talk.
# Leave blank to use only the ChatGPT subscription OAuth profile for agent models.
OPENAI_API_KEY=

# Optional Tailscale sidecar. Use a reusable, non-ephemeral auth key and a
# unique hostname for every deployment. The key is explicitly removed from
# the OpenClaw gateway and agent environments.
TAILSCALE_IMAGE=tailscale/tailscale:v1.98.9@sha256:f15d5d3f4a68773a853180b72496f70ba614b64de0878c43fe3da39fe0afba47
TAILSCALE_AUTH_KEY=tskey-auth-replace_me
TS_HOSTNAME=${COMPOSE_PROJECT_NAME}
# Add --accept-routes only if agents need Tailscale subnet routes.
TS_EXTRA_ARGS=

# OpenAI subscription auth for agent models uses the device-code login documented
# in README.md; credentials persist in the mounted state and auth-profile-secret
# directories above.
