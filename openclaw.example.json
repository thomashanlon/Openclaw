{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "trustedProxies": [
      "127.0.0.1",
      "::1"
    ],
    "auth": {
      "mode": "token",
      "allowTailscale": false,
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": true
      }
    },
    "tailscale": {
      "mode": "off"
    }
  },
  "agents": {
    "entries": {
      "main": {
        "default": true,
        "name": "T5H5",
        "workspace": "/home/node/.openclaw/workspace/t5h5",
        "agentDir": "/home/node/.openclaw/agents/main/agent",
        "model": "openai/gpt-5.6-sol",
        "tools": {
          "profile": "coding",
          "deny": [
            "headquarters-frink__*",
            "headquarters-highwright__*"
          ]
        }
      },
      "frink": {
        "name": "Frink",
        "workspace": "/home/node/.openclaw/workspace/frink",
        "agentDir": "/home/node/.openclaw/agents/frink/agent",
        "model": "openai/gpt-5.6-sol",
        "tools": {
          "profile": "coding",
          "deny": [
            "headquarters-t5h5__*",
            "headquarters-highwright__*"
          ]
        }
      },
      "highwright": {
        "name": "Highwright",
        "workspace": "/home/node/.openclaw/workspace/highwright",
        "agentDir": "/home/node/.openclaw/agents/highwright/agent",
        "model": "openai/gpt-5.6-sol",
        "tools": {
          "profile": "coding",
          "deny": [
            "headquarters-t5h5__*",
            "headquarters-frink__*"
          ]
        }
      }
    },
    "defaults": {
      "thinkingDefault": "high",
      "models": {
        "openai/gpt-5.6-sol": {}
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-5.6-sol"
        ]
      }
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "telegram",
        "accountId": "t5h5"
      }
    },
    {
      "agentId": "frink",
      "match": {
        "channel": "telegram",
        "accountId": "frink"
      }
    },
    {
      "agentId": "highwright",
      "match": {
        "channel": "telegram",
        "accountId": "highwright"
      }
    }
  ],
  "channels": {
    "telegram": {
      "enabled": true,
      "defaultAccount": "t5h5",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${TELEGRAM_OWNER_USER_ID}"
      ],
      "groupPolicy": "disabled",
      "accounts": {
        "t5h5": {
          "botToken": "${TELEGRAM_T5H5_BOT_TOKEN}",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "${TELEGRAM_OWNER_USER_ID}"
          ],
          "groupPolicy": "disabled"
        },
        "frink": {
          "botToken": "${TELEGRAM_FRINK_BOT_TOKEN}",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "${TELEGRAM_OWNER_USER_ID}"
          ],
          "groupPolicy": "disabled"
        },
        "highwright": {
          "botToken": "${TELEGRAM_HIGHWRIGHT_BOT_TOKEN}",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "${TELEGRAM_OWNER_USER_ID}"
          ],
          "groupPolicy": "disabled"
        }
      }
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:${TELEGRAM_OWNER_USER_ID}"
    ]
  },
  "tts": {
    "provider": "openai",
    "providers": {
      "openai": {
        "model": "gpt-4o-mini-tts",
        "speakerVoice": "fable"
      }
    }
  },
  "talk": {
    "realtime": {
      "provider": "openai",
      "model": "gpt-live-1-codex",
      "providers": {
        "openai": {
          "speakerVoice": "cedar"
        }
      },
      "mode": "realtime",
      "transport": "gateway-relay",
      "brain": "agent-consult"
    }
  },
  "tools": {
    "profile": "coding",
    "sessions": {
      "visibility": "all"
    },
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "main",
        "frink",
        "highwright"
      ]
    }
  },
  "plugins": {
    "entries": {
      "codex": {
        "enabled": true
      },
      "device-pair": {
        "enabled": true,
        "config": {
          "publicUrl": "${OPENCLAW_PUBLIC_URL}"
        }
      },
      "workboard": {
        "enabled": true,
        "config": {}
      }
    }
  },
  "mcp": {
    "servers": {
      "headquarters-t5h5": {
        "url": "${HEADQUARTERS_MCP_URL}",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${HEADQUARTERS_T5H5_TOKEN}"
        },
        "connectionTimeoutMs": 15000,
        "requestTimeoutMs": 60000,
        "codex": {
          "agents": [
            "main"
          ],
          "defaultToolsApprovalMode": "auto"
        }
      },
      "headquarters-frink": {
        "url": "${HEADQUARTERS_MCP_URL}",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${HEADQUARTERS_FRINK_TOKEN}"
        },
        "connectionTimeoutMs": 15000,
        "requestTimeoutMs": 60000,
        "codex": {
          "agents": [
            "frink"
          ],
          "defaultToolsApprovalMode": "auto"
        }
      },
      "headquarters-highwright": {
        "url": "${HEADQUARTERS_MCP_URL}",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${HEADQUARTERS_HIGHWRIGHT_TOKEN}"
        },
        "connectionTimeoutMs": 15000,
        "requestTimeoutMs": 60000,
        "codex": {
          "agents": [
            "highwright"
          ],
          "defaultToolsApprovalMode": "auto"
        }
      }
    }
  }
}
